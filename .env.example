# Application
ENV=development
PORT=8080
LOG_LEVEL=info
LOG_DIR=logs/api
LOG_FILE=app.log

# PostgreSQL (matches deploy/docker-compose.yml defaults)
DATABASE_URL=postgres://nexuslink:nexuslink@localhost:5432/nexuslink?sslmode=disable

# Public base URL used in short_url responses
BASE_URL=http://localhost:8080

# Redis (redirect cache + rate limiting)
REDIS_URL=redis://localhost:6379

# JWT (link management)
JWT_SECRET=dev-secret-change-me
JWT_TTL_HOURS=24

# Snowflake ID generator (0-1023)
SNOWFLAKE_MACHINE_ID=1

# Rate limits: fixed window for shorten, token bucket for redirects
RATE_LIMIT_SHORTEN=30
RATE_LIMIT_SHORTEN_WINDOW_SEC=60
RATE_LIMIT_REDIRECT_CAPACITY=100
RATE_LIMIT_REDIRECT_REFILL_PER_SEC=50

# Frontend (Vite) CORS — comma-separated origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Analytics click pipeline (Phase 4). When enabled, the redirect path publishes
# click events to a sink without blocking. Sinks: "log" (default) or "kafka".
ANALYTICS_ENABLED=false
ANALYTICS_SINK=log
ANALYTICS_BUFFER_SIZE=1024

# Kafka click-event topic (used when ANALYTICS_SINK=kafka)
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=url_clicks

# Analytics consumer (cmd/consumer): Kafka -> ClickHouse
KAFKA_GROUP_ID=nexuslink-analytics
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=nexuslink
CLICKHOUSE_USER=nexuslink
CLICKHOUSE_PASSWORD=nexuslink
CONSUMER_BATCH_SIZE=500
CONSUMER_FLUSH_INTERVAL_MS=2000
CONSUMER_HEALTH_PORT=8081
